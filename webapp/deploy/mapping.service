[Unit]
Description=Upande Bed & Zone Mapper (FastAPI/Uvicorn)
After=network.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/stive/code/mapping-script/upande-mapping-scripts/webapp/backend
ExecStart=/home/ubuntu/stive/code/mapping-script/upande-mapping-scripts/webapp/.venv/bin/uvicorn main:app --host 127.0.0.1 --port 8765 --workers 2
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
